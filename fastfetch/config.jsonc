{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "macos_small",
    "color": { "1": "38;2;205;214;244" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "key": { "type": "string", "width": 6 },
    "color": { "keys": "38;2;203;166;247", "output": "38;2;205;214;244" }
  },
  "modules": [
    "break",
    { "type": "os", "key": "os", "format": "{name} {version}" },
    { "type": "host", "key": "host", "format": "{name}" },
    { "type": "kernel", "key": "kern", "format": "{release}" },
    { "type": "uptime", "key": "up" },
    { "type": "packages", "key": "pkgs", "format": "{brew} (brew)" },
    { "type": "shell", "key": "sh", "format": "{pretty-name}" },
    { "type": "memory", "key": "mem", "format": "{used} / {total}" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0, "block": { "range": [1, 6] } }
  ]
}
